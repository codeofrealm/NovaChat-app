{
  "rules": {
    "presence": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isOnline", "lastSeen"],
      "$uid": {
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString()"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["lastMessageTime"],
      "$chatId": {
        "lastMessageTime": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$chatId": {
        ".indexOn": ["receiverId", "timestamp"],
        "$messageId": {
          ".validate": "newData.hasChildren(['senderId', 'receiverId', 'timestamp', 'type'])",
          "senderId": {
            ".validate": "newData.isString()"
          },
          "receiverId": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "text": {
            ".validate": "newData.isString()"
          }
        }
      }
    }
  }
}
