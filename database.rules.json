{
  "rules": {
    "presence": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isOnline", "lastSeen"],
      "$uid": {
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString()"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["lastMessageTime", "participants"]
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$chatId": {
        ".indexOn": ["receiverId", "timestamp"]
      }
    }
  }
}
